{
    "name": "ipiner/admin",
    "type": "project",
    "description": "基于 Pin 开发的极简后台管理系统 API 示例",
    "keywords": ["framework", "laravel", "pin", "admin"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ipiner/access": "^1.0",
        "ipiner/captcha": "^1.0",
        "ipiner/modules-log": "^1.0",
        "ipiner/pin": "^1.0",
        "ipiner/upload": "^1.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "dedoc/scramble": "^0.13",
        "fakerphp/faker": "^1.21",
        "laravel-lang/lang": "^15.8",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.4",
        "spatie/laravel-ignition": "^2.0",
        "swoole/ide-helper": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_put_contents('.env', PHP_EOL.'CRYPT_KEY='.substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'),0,16).PHP_EOL.'CRYPT_IV='.substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'),0,16).PHP_EOL, FILE_APPEND);\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
